# Profil d'agent : Claude Code piloté par DeepSeek (orchestration/decisions.md, décision 37).
# Aucun secret ici : VARIABLE_CLE est le NOM de la variable d'environnement
# qui porte la clé, jamais sa valeur.
ADRESSE=https://api.deepseek.com/anthropic
MODELE=deepseek-flash
VARIABLE_CLE=DEEPSEEK_API_KEY
# Tarif par million de jetons, en dollars — pointe, relevé le 2026-09-14 ;
# hors pointe, la sortie coûte moitié. Sert au calcul du coût dans agents.tsv.
PRIX_ENTREE=0.30
PRIX_CACHE=0.006
PRIX_SORTIE=1.20
