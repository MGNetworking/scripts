# Profil d'agent : Claude Code piloté par l'API Anthropic, facturée à la clé et non à l'abonnement.
# Aucun secret ici : VARIABLE_CLE est le NOM de la variable d'environnement
# qui porte la clé, jamais sa valeur.
# Plusieurs modèles, une seule clé : lancer-agent.sh anthropic TASK-XXX --modele <alias>.
# Sans --modele, l'alias de MODELE_DEFAUT.
ADRESSE=https://api.anthropic.com
VARIABLE_CLE=ANTHROPIC_API_KEY
MODELE_DEFAUT=haiku
# PRIX_<alias> : entrée, lecture du cache, sortie — dollars par million de jetons.
# Relevés le 2026-09-19 sur platform.claude.com/docs/en/about-claude/pricing ; cache en lecture = 0,1 x l'entrée.
MODELE_haiku=claude-haiku-4-5
PRIX_haiku=1.00 0.10 5.00
MODELE_sonnet=claude-sonnet-5
PRIX_sonnet=2.00 0.20 10.00
MODELE_opus=claude-opus-5
PRIX_opus=5.00 0.50 25.00
