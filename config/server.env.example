# Contexte de ce serveur — copier en config/server.env et adapter.
#
#   cp config/server.env.example config/server.env
#
# Chargé automatiquement par lib/common.sh. Décrit LA MACHINE ; les
# configurations applicatives (docker.env, k3s.env…) sont chargées séparément
# par les scripts, via load_config.
#
# Chargé par « source » : uniquement des affectations, jamais de commandes.
# Non versionné : propre à chaque serveur.
#
# Les valeurs de la ligne de commande priment toujours sur celles-ci.


# --- Journalisation --------------------------------------------------------
# Sans cette ligne : /var/log/mgnetworking en root, <racine du dépôt>/logs sinon.
#LOG_DIR="/var/log/mgnetworking"


# --- Identité --------------------------------------------------------------
# Nom d'hôte appliqué par Linux/System/configure-hostname.sh.
#SRV_HOSTNAME="mon-serveur"

# Fuseau horaire appliqué par Linux/System/configure-timezone.sh.
#SRV_TIMEZONE="Europe/Paris"


# --- Ressources ------------------------------------------------------------
# Taille du fichier d'échange gérée par Linux/System/configure-swap.sh.
#SRV_SWAP_SIZE="2G"


# --- Diagnostic de stockage ------------------------------------------------
# Seuil d'alerte de Linux/System/check-disk.sh, en pourcentage d'occupation.
# Un entier de 1 à 100. Il s'applique aux blocs comme aux inodes : un système de
# fichiers qui l'atteint est signalé par un [WARN], sans que le code de retour
# du script en soit changé.
#
# Sans cette ligne : 85. Voir Linux/System/README.md, « Seuils de check-disk.sh »,
# pour la justification de cette valeur.
#SRV_DISK_SEUIL="85"

# Répertoire dont Linux/System/check-disk.sh analyse les sous-répertoires les
# plus consommateurs, à la profondeur 1 et sans franchir les points de montage.
#
# Sans cette ligne : « / ».
#SRV_DISK_REPERTOIRE="/"


# --- Diagnostic mémoire ----------------------------------------------------
# Seuil d'alerte de Linux/System/check-memory.sh, en pourcentage de mémoire
# NON DISPONIBLE — (totale - disponible) / totale. Un entier de 1 à 100.
#
# Il porte sur la mémoire DISPONIBLE et jamais sur la mémoire LIBRE : Linux
# emploie toute mémoire inemployée en cache, qu'il rend dès qu'un programme en
# réclame, si bien qu'un serveur sain affiche presque toujours une mémoire libre
# proche de zéro. Un seuil posé sur « libre » crierait au loup à chaque passage.
#
# Il vaut aussi pour le fichier d'échange, mais l'avertissement n'est émis qu'à
# la CONJONCTION des deux : un échange occupé alors que la mémoire l'est aussi.
# Un échange occupé seul est le fonctionnement normal du noyau.
#
# Sans cette ligne : 90. Voir Linux/System/README.md, « Seuils de check-memory.sh »,
# pour la justification de cette valeur et sa différence avec celle de check-disk.sh.
#SRV_MEM_SEUIL="90"

# Nombre de processus affichés par Linux/System/check-memory.sh, triés sur la
# mémoire résidente décroissante. Un entier de 1 à 100.
#
# Sans cette ligne : 10. Dix lignes conviennent à un serveur applicatif, trois
# suffisent à un VPS qui n'héberge qu'un service.
#SRV_MEM_TOP="10"


# --- Tâches planifiées -----------------------------------------------------
# Horaire de la mise à jour des paquets, déposée par
# Linux/System/configure-cron.sh dans /etc/cron.d/mgnetworking.
#
# Les cinq champs de cron, entre guillemets, dans cet ordre :
#   minute  heure  jour-du-mois  mois  jour-de-semaine
# Les raccourcis « @weekly » et consorts ne sont pas acceptés.
#
# Sans cette ligne : « 0 4 * * 1 » — tous les lundis à 4 h.
# L'horaire suit le fuseau horaire du système (SRV_TIMEZONE ci-dessus).
#SRV_CRON_UPDATE_SYSTEM="0 4 * * 1"


# --- Démon Docker ----------------------------------------------------------
# Rotation des journaux de conteneurs, écrite par
# Docker/Configuration/configure-docker.sh dans /etc/docker/daemon.json.
#
# Sans rotation, un conteneur bavard remplit /var/lib/docker jusqu'à saturer le
# disque : c'est le serveur entier qui tombe, pas le conteneur. Le pilote et la
# rotation ne sont lus qu'à la CRÉATION d'un conteneur — ceux qui tournent déjà
# gardent leur configuration, et leurs fichiers de journal existants ne sont ni
# tronqués ni supprimés.
#
# Pilote de journalisation. Seuls « json-file » et « local » sont acceptés ; un
# pilote distant (syslog, gelf, fluentd…) casse « docker logs » et suppose une
# infrastructure tierce.
# Sans cette ligne : « json-file ».
#SRV_DOCKER_LOG_DRIVER="json-file"

# Taille maximale d'un fichier de journal avant rotation. Un entier suivi de k,
# m ou g.
# Sans cette ligne : « 10m » — de quoi diagnostiquer un incident de la veille
# sans menacer le disque d'un VPS.
#SRV_DOCKER_LOG_MAX_SIZE="10m"

# Nombre de fichiers de journal conservés par conteneur, rotation comprise. Un
# entier positif.
# Sans cette ligne : « 3 ».
#SRV_DOCKER_LOG_MAX_FILE="3"

# Nom du réseau Docker externe posé par Docker/Configuration/create-network.sh,
# partagé entre plusieurs projets Compose distincts (chacun le déclare
# "external: true" plutôt que de créer le sien). Aucune valeur ne convient à
# toutes les machines : « proxy » ci-dessous n'est qu'un exemple.
#
# La ligne de commande prime toujours : create-network.sh mon-reseau ignore
# cette variable. Sans argument ni cette ligne, le script refuse en nommant
# les deux façons de fournir le nom.
#SRV_DOCKER_NETWORK="proxy"

# Réseaux Docker que Docker/Cleanup/docker-cleanup.sh ne doit JAMAIS proposer ni
# supprimer, même inutilisés au moment du relevé. Noms séparés par des espaces.
#
# Un réseau d'infrastructure inutilisé l'est souvent par accident : un conteneur
# arrêté le temps d'une maintenance, un projet Compose pas encore remonté après
# un redémarrage. Le nettoyage l'emporterait, et les conteneurs qui le déclarent
# « external: true » ne redémarreraient plus. SRV_DOCKER_NETWORK ci-dessus est
# protégé d'office ; cette liste couvre les autres.
#
# Sans cette ligne : aucun réseau supplémentaire n'est protégé.
#SRV_DOCKER_RESEAUX_PROTEGES="reseau-infra reseau-monitoring"
