# Contexte de ce serveur — copier en config/server.env et adapter.
#
#   cp config/server.env.example config/server.env
#
# Chargé automatiquement par lib/common.sh. Décrit LA MACHINE ; les
# configurations applicatives (docker.env, k3s.env…) sont chargées séparément
# par les scripts, via load_config.
#
# Chargé par « source » : uniquement des affectations, jamais de commandes.
# Non versionné : propre à chaque serveur.
#
# Les valeurs de la ligne de commande priment toujours sur celles-ci.


# --- Journalisation --------------------------------------------------------
# Sans cette ligne : /var/log/mgnetworking en root, <racine du dépôt>/logs sinon.
#LOG_DIR="/var/log/mgnetworking"


# --- Identité --------------------------------------------------------------
# Nom d'hôte appliqué par Linux/System/configure-hostname.sh.
#SRV_HOSTNAME="mon-serveur"

# Fuseau horaire appliqué par Linux/System/configure-timezone.sh.
#SRV_TIMEZONE="Europe/Paris"


# --- Ressources ------------------------------------------------------------
# Taille du fichier d'échange gérée par Linux/System/configure-swap.sh.
#SRV_SWAP_SIZE="2G"


# --- Tâches planifiées -----------------------------------------------------
# Horaire de la mise à jour des paquets, déposée par
# Linux/System/configure-cron.sh dans /etc/cron.d/mgnetworking.
#
# Les cinq champs de cron, entre guillemets, dans cet ordre :
#   minute  heure  jour-du-mois  mois  jour-de-semaine
# Les raccourcis « @weekly » et consorts ne sont pas acceptés.
#
# Sans cette ligne : « 0 4 * * 1 » — tous les lundis à 4 h.
# L'horaire suit le fuseau horaire du système (SRV_TIMEZONE ci-dessus).
#SRV_CRON_UPDATE_SYSTEM="0 4 * * 1"
